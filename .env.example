# Errand runs with ZERO keys (mock catalog + mock PayPal order). Add keys to go live.

# --- PayPal (sandbox) --- https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox            # "sandbox" | "live"
PAYPAL_CURRENCY=USD           # PayPal does NOT support INR as a txn currency.
                              # Use USD + a US sandbox buyer (Sandbox Accounts ->
                              # Create account -> Personal -> United States).

# --- Channel3 product data --- optional; falls back to a mock catalog
CHANNEL3_API_KEY=

# --- AI model --- optional; falls back to a deterministic planner.
# The agent runs on Meta Muse. Two ways to reach it (checked in this order):
#
# 1) Baseten (recommended for CLOUD/hosted deploys): hosts the open Muse model
#    from its own infra, so it works from any region. api.meta.ai gates its
#    catalog by region/IP and returns no models from some datacenters.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
#
# 2) Meta API direct (great for LOCAL dev from an entitled region):
#    key from https://dev.meta.ai/platform. MODEL_API_KEY / MODEL_API_BASE_URL /
#    MUSE_MODEL are accepted as aliases.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
#
# Or route a plain model id through the Vercel AI Gateway (used if no META key):
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.5
